# 上游 OpenAI 兼容服务的 API Key
OPENAI_API_KEY=sk-your-key-here

# 上游 base URL，必须含 /v1，无尾斜杠
# 飞鱼 AI：https://feiyuai.icu/v1
# 或自建中转：https://your-proxy.example.com/v1
OPENAI_BASE_URL=https://feiyuai.icu/v1

# 单次请求超时秒
OPENAI_TIMEOUT=120

# 可选：备用上游。主上游 5xx / 超时 / 429 / 401 时自动回退一次
# 留空 = 关闭回退，主上游任何错误直接抛给前端
OPENAI_API_KEY_BACKUP=
OPENAI_BASE_URL_BACKUP=

# 免 Key 备用文生图示例：Pollinations.AI
# OPENAI_API_KEY_BACKUP=-
# OPENAI_BASE_URL_BACKUP=https://image.pollinations.ai
# 其他可手动添加到后台渠道页的文生图-only base URL 示例：
# Cloudflare Workers AI:
# https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/run/@cf/black-forest-labs/flux-1-schnell
# Google Gemini:
# https://generativelanguage.googleapis.com/v1/models/gemini-2.5-flash-image:generateContent
# Hugging Face:
# https://router.huggingface.co/fal-ai/fal-ai/flux/dev

# 可选：中转商若用变体模型名（如 gpt-image-2-vip），在此覆盖。留空则原样转发前端传入的 model
# 用于 ≤2048 边长的请求
UPSTREAM_MODEL_OVERRIDE=
# 可选：4K（>2048 边长）请求时使用的变体名，留空则与 UPSTREAM_MODEL_OVERRIDE 相同
UPSTREAM_MODEL_OVERRIDE_4K=

# 抠图后端：grabcut（默认）/ rembg / sam
SEGMENT_BACKEND=grabcut
# 抠图所用 rembg 模型（仅 SEGMENT_BACKEND=rembg）
REMBG_MODEL=u2netp

# Optional SAM backend. Use when SEGMENT_BACKEND=sam.
# Download a checkpoint from Segment Anything, for example sam_vit_b_01ec64.pth.
SAM_CHECKPOINT=
SAM_MODEL_TYPE=vit_b
# auto = cuda if torch sees a GPU, otherwise cpu.
SAM_DEVICE=auto

# ============ auth-foundation ============
# MySQL 异步驱动；用户必须有 image2 库的 DML+DDL 权限
DATABASE_URL=mysql+asyncmy://user:password@host:3306/image2?charset=utf8mb4

# Redis；NAS 实例示例
REDIS_URL=redis://192.168.50.250:6380/0

# 运行环境：development / production；生产时启动校验更严
APP_ENV=development

# JWT 签名密钥（至少 64 字符随机串）。生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
# JWT 默认有效期（小时）；建议生产 24
JWT_EXP_HOURS=24
# 兼容旧 env：未设 JWT_EXP_HOURS 时回退读取，按小时 = 天 × 24
# JWT_EXP_DAYS=7

BCRYPT_ROUNDS=12
# 新用户注册赠送积分
SIGNUP_BONUS_CREDITS=5
# 登录失败限流：5 分钟内失败 5 次 → 锁 15 分钟
LOGIN_FAIL_MAX=5
LOGIN_FAIL_WINDOW=300
LOGIN_LOCK_TTL=900

# ============ P1 安全加固 ============
# proxy-image 反代白名单：逗号分隔的 host 列表，留空时只允许 OPENAI_BASE_URL 同 host
# 生产环境必须配；至少把上游 CDN 域名加进来（图床 URL 是上游 CDN，不一定与 API host 一致）
PROXY_IMAGE_HOST_ALLOWLIST=

# 限流策略（slowapi 表达式："次数/时间窗"）
# 全局 IP 每分钟最多 120 次；超额返回 429
RATE_LIMIT_GLOBAL=120/minute
# 单用户生图/改图：每分钟最多 6 次（防烧上游 API key）
RATE_LIMIT_GENERATE=6/minute
# 单用户抠图（CPU 密集 ML 推理）：每分钟最多 12 次
RATE_LIMIT_SEGMENT=12/minute
# 注册接口：每 IP 每小时最多 3 次
RATE_LIMIT_REGISTER=3/hour

# 上传字节硬限：edit / brush-cutout 单文件上限（默认 10 MB）
UPLOAD_MAX_BYTES=10485760

# ============ 邮箱验证 / 邮件 provider（auth P2） ============
# provider：smtp（生产默认，QQ/腾讯 SMTP）/ console（开发期写日志）/ null（测试用）
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_ALIAS=image2
# 验证链接的 base URL；生产必须是 https://
EMAIL_VERIFY_BASE_URL=http://127.0.0.1:5173/verify-email
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFY_DAILY_LIMIT=5
RATE_LIMIT_VERIFY_EMAIL=5/hour
RATE_LIMIT_RESEND_VERIFICATION=5/hour

# ============ SMTP provider（仅 EMAIL_PROVIDER=smtp 时生效） ============
# QQ 邮箱：smtp.qq.com:465 (SSL) 或 587 (STARTTLS)
# 腾讯企业邮：smtp.exmail.qq.com:465 (SSL) 或 587 (STARTTLS)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
# 发件邮箱（必填）
SMTP_USER=
# QQ 邮箱里生成的「授权码」，不是 QQ 密码（必填）
SMTP_PASS=
# 默认与 SMTP_USER 相同
SMTP_FROM=
SMTP_FROM_NAME=image2
